{
  "plugins": [
    "plugins/markdown"
  ],
  "source": {
    "include": [
      "lab-js",
      "ghostyles"
    ],
    "includePattern": ".+\\.js(doc|x)?$",
    "excludePattern": "(^|\\/|\\\\)_",
    "exclude": [
      "lab-js/vendor/**"
    ]
  },
  "opts": {
    "theme_opts": {
      "default_theme": "light",
      "footer": "<div style='text-align: center; padding: 1rem 0;'>Ghostmaxxing v1.0.0 | Last updated: 15 October 2026</div>"
    },
    "template": "node_modules/clean-jsdoc-theme",
    "tutorials": "./tutorials",
    "basePath": "/docs/jsdoc/",
    "destination": "./docs/jsdoc",
    "recurse": true,
    "readme": "./JSDOC_index.md"
  },
  "markdown": {
    "idInHeadings": true
  }
}
